{
  "name": "linguaforge",
  "version": "1.0.0",
  "description": "LinguaForge: нативное Mac приложение для изучения английского с нуля",
  "main": "dist-electron/main.js",
  "author": "Skizziik",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build:react": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build:react && npm run build:electron",
    "build:mac": "npm run build:all && electron-builder --mac",
    "build:mac-arm": "npm run build:all && electron-builder --mac --arm64",
    "build:mac-intel": "npm run build:all && electron-builder --mac --x64",
    "db:generate": "drizzle-kit generate",
    "build-dict": "tsx scripts/build-dictionary.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@mistralai/mistralai": "^2.2.1",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "framer-motion": "^11.11.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.13.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.0",
    "ts-fsrs": "^4.6.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.28.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.linguaforge.app",
    "productName": "LinguaForge"
  }
}
